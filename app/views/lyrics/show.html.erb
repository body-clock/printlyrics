<%
  display_title = @lyric.title.presence || t(".untitled")
  display_artist = @lyric.artist.presence
  seo_title = if display_artist
    t(".seo.title_with_artist", title: display_title, artist: display_artist)
  else
    t(".seo.title_without_artist", title: display_title)
  end
  description = if display_artist
    t(".seo.description_with_artist", title: display_title, artist: display_artist)
  else
    t(".seo.description_without_artist")
  end
  structured_data = {
    "@context": "https://schema.org",
    "@type": "MusicRecording",
    name: display_title,
    byArtist: display_artist && { "@type": "MusicGroup", name: display_artist },
    url: lyric_url(@lyric)
  }.compact
%>
<% content_for :title, seo_title %>
<% content_for :description, description %>
<% content_for :canonical_url, lyric_url(@lyric) %>
<% content_for :og_type, "music.song" %>
<% content_for :robots, "noindex, nofollow" %>
<% content_for :body_class, "preview-body" %>
<% content_for :generated_page_key, @generated_page_key if @generated_page_key %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw json_escape(structured_data.to_json) %></script>
<% end %>

<div class="preview-shell"
     data-controller="preview"
     data-action="resize@window->preview#fitPagePreview afterprint@window->preview#restorePagePreview">
  <nav class="control-bar no-print" aria-label="<%= t(".controls.label") %>">
    <div class="control-inner">
      <%= link_to root_path, class: "back-link" do %>
        <span aria-hidden="true">←</span>
        <span><%= t(".controls.back") %></span>
      <% end %>

      <div class="control-groups">
        <fieldset class="segmented-control">
          <legend><%= t(".controls.size") %></legend>
          <% %w[s m l xl].each do |size| %>
            <button type="button"
                    class="<%= size == "m" ? "is-active" : nil %>"
                    aria-pressed="<%= size == "m" %>"
                    data-preview-target="sizeButton"
                    data-action="preview#setSize"
                    data-size="<%= size %>"><%= t(".controls.sizes.#{size}") %></button>
          <% end %>
        </fieldset>

        <fieldset class="segmented-control columns-control">
          <legend><%= t(".controls.columns") %></legend>
          <% [1, 2].each do |columns| %>
            <button type="button"
                    class="<%= columns == 1 ? "is-active" : nil %>"
                    aria-pressed="<%= columns == 1 %>"
                    data-preview-target="columnButton"
                    data-action="preview#setColumns"
                    data-columns="<%= columns %>"><%= columns %></button>
          <% end %>
        </fieldset>

        <button type="button" class="button button-print" data-action="preview#print">
          <span aria-hidden="true">↗</span>
          <span><%= t(".controls.print") %></span>
        </button>
      </div>
    </div>
  </nav>

  <div class="paper-frame" data-preview-target="pageFrame">
    <article class="paper size-m" data-preview-target="page">
      <header class="lyric-header">
        <h1><%= display_title %></h1>
        <% if display_artist %>
          <p><%= display_artist %></p>
        <% end %>
      </header>

      <div class="lyrics" data-preview-target="lyrics">
        <% @lyric.stanzas.each do |stanza| %>
          <section class="stanza"><%= stanza %></section>
        <% end %>
      </div>
    </article>
  </div>

  <% if @generated_page_key %>
    <aside class="preview-feedback no-print"
           aria-labelledby="print-use-case-heading"
           data-controller="print-feedback">
      <fieldset data-print-feedback-target="question">
        <legend id="print-use-case-heading"><%= t(".feedback.question") %></legend>
        <p><%= t(".feedback.explanation") %></p>
        <div class="feedback-options">
          <button type="button"
                  data-action="print-feedback#select"
                  data-use-case="performance"><%= t(".feedback.performance") %></button>
          <button type="button"
                  data-action="print-feedback#select"
                  data-use-case="worship_community"><%= t(".feedback.worship_community") %></button>
          <button type="button"
                  data-action="print-feedback#select"
                  data-use-case="teaching"><%= t(".feedback.teaching") %></button>
          <button type="button"
                  data-action="print-feedback#select"
                  data-use-case="personal"><%= t(".feedback.personal") %></button>
        </div>
      </fieldset>
      <p class="feedback-thanks"
         role="status"
         data-print-feedback-target="thanks"
         hidden><%= t(".feedback.thanks") %></p>
    </aside>
  <% end %>
</div>
