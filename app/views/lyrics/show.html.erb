<%
  display_title = lyric_title(@lyric)
  display_artist = @lyric.artist.presence
  seo_title = if display_artist
    t(".seo.title_with_artist", title: display_title, artist: display_artist)
  else
    t(".seo.title_without_artist", title: display_title)
  end
  description = if display_artist
    t(".seo.description_with_artist", title: display_title, artist: display_artist)
  else
    t(".seo.description_without_artist")
  end
  structured_data = {
    "@context": "https://schema.org",
    "@type": "MusicRecording",
    name: display_title,
    byArtist: display_artist && { "@type": "MusicGroup", name: display_artist },
    url: lyric_url(@lyric)
  }.compact
%>
<% content_for :title, seo_title %>
<% content_for :description, description %>
<% content_for :canonical_url, lyric_url(@lyric) %>
<% content_for :og_type, "music.song" %>
<% content_for :robots, "noindex, nofollow" %>
<% content_for :body_class, "preview-body" %>
<% content_for :generated_page_key, @generated_page_key if @generated_page_key %>
<% content_for :head do %>
  <%= render "shared/structured_data", structured_data: structured_data %>
<% end %>

<div class="preview-shell"
     data-controller="preview"
     data-action="resize@window->preview#fitPagePreview afterprint@window->preview#restorePagePreview">
  <nav class="control-bar no-print" aria-label="<%= t(".controls.label") %>">
    <div class="control-inner">
      <div class="control-start">
        <%= link_to root_path, class: "back-link" do %>
          <span aria-hidden="true">←</span>
          <span><%= t(".controls.back") %></span>
        <% end %>

        <%= button_to songbooks_path,
              params: { lyric_token: @lyric.token, then: "add_song" },
              class: "button button-secondary button-add-song" do %>
          <span aria-hidden="true">+</span>
          <span><%= t(".controls.add_to_songbook") %></span>
        <% end %>
      </div>

      <div class="control-groups">
        <%= render "shared/preview_controls" %>

        <button type="button" class="button button-print" data-action="preview#print">
          <span aria-hidden="true">↗</span>
          <span><%= t(".controls.print") %></span>
        </button>
      </div>
    </div>
  </nav>

  <%# A sheet that was just generated is one of the two moments a visit can
      become a set; the other is the entry panel it returns to. %>
  <%= render "shared/songbook_prompt" if @generated_page_key %>

  <p class="page-summary no-print"
     data-preview-target="pageSummary"
     data-one-page-label="<%= t(".page_count.one") %>"
     data-many-pages-label="<%= t(".page_count.other") %>"
     aria-live="polite"></p>

  <div class="paper-frame" data-preview-target="pageFrame">
    <div class="paper-pages" data-preview-target="pages">
      <article class="paper size-m is-unpaginated" data-preview-target="page" data-preview-page data-preview-song>
        <header class="lyric-header">
          <h1><%= display_title %></h1>
          <% if display_artist %>
            <p><%= display_artist %></p>
          <% end %>
        </header>

        <div class="lyrics">
          <% @lyric.stanzas.each do |stanza| %>
            <section class="stanza"><%= stanza %></section>
          <% end %>
        </div>
      </article>
    </div>
  </div>

</div>
