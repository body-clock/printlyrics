<%
  display_title = lyric_title(@lyric)
  display_artist = @lyric.artist.presence
  seo_title = if display_artist
    t(".seo.title_with_artist", title: display_title, artist: display_artist)
  else
    t(".seo.title_without_artist", title: display_title)
  end
  description = if display_artist
    t(".seo.description_with_artist", title: display_title, artist: display_artist)
  else
    t(".seo.description_without_artist")
  end
  structured_data = {
    "@context": "https://schema.org",
    "@type": "MusicRecording",
    name: display_title,
    byArtist: display_artist && { "@type": "MusicGroup", name: display_artist },
    url: lyric_url(@lyric)
  }.compact
%>
<% content_for :title, seo_title %>
<% content_for :description, description %>
<% content_for :canonical_url, lyric_url(@lyric) %>
<% content_for :og_type, "music.song" %>
<% content_for :robots, "noindex, nofollow" %>
<% content_for :body_class, "preview-body" %>
<% content_for :hide_site_chrome, true %>
<% content_for :generated_page_key, @generated_page_key if @generated_page_key %>
<% content_for :head do %>
  <%= render "shared/structured_data", structured_data: structured_data %>
<% end %>

<div class="preview-shell"
     data-controller="preview workspace"
     data-action="resize@window->preview#fitPagePreview afterprint@window->preview#restorePagePreview keydown@window->workspace#escape">
  <%= render "shared/flash" %>

  <nav class="control-bar workspace-actions no-print" aria-label="<%= t(".controls.label") %>">
    <div class="control-inner">
      <div class="control-start">
        <%= link_to root_path(revision: @lyric.token), class: "back-link", data: { preview_target: "revisionLink" } do %>
          <span aria-hidden="true">←</span>
          <span><%= t("redesign_preview.edit") %></span>
        <% end %>
      </div>
      <div class="control-groups">
        <button type="button" class="button button-secondary workspace-format-trigger"
                data-workspace-target="trigger" data-action="workspace#toggleInspector"
                aria-controls="workspace-inspector" aria-expanded="false"><%= t("redesign_preview.format_sheet") %></button>
        <button type="button" class="button button-print" data-action="preview#print">
          <span><%= t(".controls.print") %></span>
        </button>
      </div>
    </div>
  </nav>

  <div class="workspace-layout">
    <section class="workspace-stage" aria-label="<%= t("redesign_preview.sheet_preview") %>">
      <%= render "shared/preview_view_controls" %>
      <%= render "shared/sheet_mark" %>
      <div class="paper-frame" data-preview-target="pageFrame">
        <div class="paper-pages" data-preview-target="pages" aria-busy="true">
          <article class="paper size-m is-unpaginated" data-preview-target="page" data-preview-page data-preview-song>
            <header class="lyric-header">
              <h1><%= display_title %></h1>
              <% if display_artist %>
                <p><%= display_artist %></p>
              <% end %>
            </header>
            <div class="lyrics">
              <% @lyric.stanzas.each do |stanza| %>
                <section class="stanza"><%= stanza %></section>
              <% end %>
            </div>
          </article>
        </div>
      </div>
    </section>

    <div class="workspace-secondary no-print">
      <%= link_to t("redesign_preview.new_sheet"), root_path, class: "button-text" %>
      <%= button_to songbooks_path,
            params: { lyric_token: @lyric.token, then: "add_song", size: "m", columns: 1 },
            class: "button button-secondary button-add-song",
            form: { data: { controller: "layout-preference" } } do %>
        <span aria-hidden="true">+</span>
        <span><%= t(".controls.add_to_songbook") %></span>
      <% end %>
      <%= render "shared/songbook_prompt", surface: "sheet" if @generated_page_key %>
      <% if authenticated? %>
        <%= render "shared/library_prompt", item: @lyric %>
      <% elsif @account_prompt %>
        <%= render "shared/account_prompt", item: @lyric, surface: "sheet" %>
      <% end %>
      <%= render "shared/feedback_prompt", page_key: @generated_page_key %>
    </div>

    <aside id="workspace-inspector" class="workspace-inspector no-print"
           data-workspace-target="inspector" aria-labelledby="workspace-inspector-heading" hidden>
      <div class="workspace-inspector-heading">
        <h2 id="workspace-inspector-heading" tabindex="-1" data-workspace-target="heading"><%= t("redesign_preview.format_sheet") %></h2>
        <button type="button" class="button button-secondary workspace-inspector-close"
                data-action="workspace#closeInspector"><%= t("redesign_preview.close") %></button>
      </div>
      <p class="workspace-hint"><%= t("redesign_preview.print_format_hint") %></p>
      <%= render "shared/preview_controls" %>
    </aside>
  </div>
</div>
