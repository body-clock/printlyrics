<%
  seo_description = t(".seo.description")
  structured_data = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "#{root_url}#website",
        url: root_url,
        name: t("application.name"),
        alternateName: t("application.alternate_name"),
        description: seo_description
      },
      {
        "@type": "WebApplication",
        "@id": "#{root_url}#application",
        url: root_url,
        name: t("application.name"),
        description: seo_description,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: t(".structured_data.operating_system"),
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD"
        },
        isPartOf: { "@id": "#{root_url}#website" }
      }
    ]
  }
%>
<% content_for :title, t(".seo.title") %>
<% content_for :description, seo_description %>
<% content_for :canonical_url, root_url %>
<% content_for :robots, "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw json_escape(structured_data.to_json) %></script>
<% end %>

<div class="landing-shell">
  <%= turbo_frame_tag "lyric_entry", class: "landing-frame" do %>
    <%= render "shared/flash" %>

    <section class="entry-panel" aria-labelledby="page-heading">
      <div class="intro">
        <h1 id="page-heading"><%= t("application.name") %></h1>
        <p><%= t(".intro") %></p>
      </div>

      <div class="search-section">
        <div class="section-heading">
          <h2><%= t(".search.heading") %></h2>
          <p><%= t(".search.provider") %></p>
        </div>

        <div class="search-composer"
          data-controller="lyric-search"
          data-action="click@window->lyric-search#dismissFromOutside keydown.esc@window->lyric-search#close">
          <%= form_with url: search_lyrics_path,
            method: :post,
            data: {
              turbo_frame: "lyric_entry",
              action: "turbo:submit-start->lyric-search#start turbo:submit-end->lyric-search#finish"
            },
            html: { aria: { busy: "false" } },
            class: "search-form" do |form| %>
            <div class="field grow">
              <%= form.label :query, t(".search.query"), class: "sr-only" %>
              <%= form.search_field :query,
                value: @query,
                placeholder: t(".search.query"),
                autocomplete: "off",
                required: true,
                aria: (@results.present? || @search_error.present? ? { controls: "song-search-results" } : {}),
                data: { lyric_search_target: "query" } %>
            </div>
            <%= form.button class: "button button-secondary search-submit" do %>
              <span data-lyric-search-target="idleLabel"><%= t(".search.submit") %></span>
              <span class="search-busy-label" data-lyric-search-target="busyLabel" hidden>
                <span class="search-spinner" aria-hidden="true"></span>
                <%= t(".search.busy") %>
              </span>
            <% end %>
          <% end %>

          <% if @results.present? || @search_error.present? %>
            <section id="song-search-results"
              class="search-results-panel"
              aria-label="<%= t(".search.results_label") %>"
              data-lyric-search-target="panel">
              <div class="search-results-header">
                <% if @search_error.present? %>
                  <p role="alert"><%= @search_error %></p>
                <% else %>
                  <p role="status" aria-live="polite"><%= @search_status %></p>
                <% end %>
                <button type="button"
                  class="search-results-close"
                  aria-label="<%= t(".search.close") %>"
                  title="<%= t(".search.close") %>"
                  data-action="lyric-search#close">&times;</button>
              </div>

              <% if @results.present? %>
                <div class="search-results" role="list" aria-label="<%= t(".search.matches_label") %>">
                  <% @results.each do |result| %>
                    <%= form_with url: select_lyrics_path,
                      method: :post,
                      data: {
                        turbo_frame: "lyric_entry",
                        action: "turbo:submit-end->lyric-search#selected"
                      },
                      class: "search-result",
                      role: "listitem" do |form| %>
                      <%= form.hidden_field :result_id, value: result.id, id: nil %>
                      <%= form.hidden_field :query, value: @query, id: nil %>
                      <%= form.button class: "search-result-button" do %>
                        <span class="search-result-copy">
                          <strong><%= result.title %></strong>
                          <span><%= result.artist %></span>
                        </span>
                        <span class="search-result-meta">
                          <% if result.album.present? %><span><%= result.album %></span><% end %>
                          <% if result.duration.positive? %><span><%= song_duration(result.duration) %></span><% end %>
                        </span>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </section>
          <% end %>
        </div>
      </div>

      <div class="divider"><span><%= t(".manual_divider") %></span></div>

      <%= form_with model: @lyric, url: lyrics_path, data: { turbo: false }, class: "lyrics-form" do |form| %>
        <% if @loaded_status.present? %>
          <p class="sr-only" role="status" aria-live="polite"><%= @loaded_status %></p>
        <% end %>
        <%= form.hidden_field :source_url if @lyric.source_url.present? %>
        <%= hidden_field_tag :catalog_token, @catalog_token if @catalog_token.present? %>

        <div class="metadata-grid">
          <div class="field">
            <%= form.label :title, t(".form.title") %>
            <%= form.text_field :title, placeholder: t(".form.optional"), autocomplete: "off" %>
          </div>
          <div class="field">
            <%= form.label :artist, t(".form.artist") %>
            <%= form.text_field :artist, placeholder: t(".form.optional"), autocomplete: "off" %>
          </div>
        </div>

        <div class="field">
          <div class="field-label-row">
            <%= form.label :lyrics, t(".form.lyrics") %>
            <span><%= t(".form.required") %></span>
          </div>
          <%= form.text_area :lyrics,
            rows: 15,
            placeholder: t(".form.lyrics_placeholder"),
            required: true %>
        </div>

        <%= form.button t(".form.submit"), class: "button button-primary button-wide" %>
      <% end %>
    </section>
  <% end %>

  <section class="tool-explainer" aria-labelledby="how-it-works">
    <p class="eyebrow"><%= t(".explainer.eyebrow") %></p>
    <h2 id="how-it-works"><%= t(".explainer.heading") %></h2>
    <p><%= t(".explainer.body") %></p>
  </section>

  <%= render "shared/resource_navigation", current_section: :tool %>

  <footer class="landing-footer">
    <p><%= t(".footer.retention") %></p>
    <p class="app-version"
       aria-label="<%= t(".footer.version", version: app_version) %>"><%= t(".footer.version_display", version: app_version) %></p>
  </footer>
</div>
