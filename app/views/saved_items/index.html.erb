<% content_for :title, t("accounts.library.title") %>
<% content_for :description, t("accounts.library.description") %>
<% content_for :robots, "noindex, nofollow" %>

<div class="guide-shell">
  <article class="guide account-page">
    <%= render "shared/account_bar" %>

    <header>
      <p class="eyebrow"><%= t("accounts.eyebrow") %></p>
      <h1><%= t("accounts.library.heading") %></h1>
      <p><%= t("accounts.library.intro", limit: SavedItem::LIMIT) %></p>
      <p class="library-count">
        <%= t("accounts.library.count", count: @saved_items.size, limit: SavedItem::LIMIT) %>
      </p>
    </header>

    <%= render "shared/flash" %>

    <%# Opening the library is the signed-in habit worth reading. A fresh key per
        render makes every genuine open count while a Turbo snapshot still does
        not report twice. %>
    <div hidden
         data-analytics-page-response="Account Library Opened"
         data-analytics-response-key="<%= SecureRandom.hex(8) %>"></div>

    <% if @saved_items.any? %>
      <ul class="library-list">
        <% @saved_items.each do |saved_item| %>
          <li class="library-item">
            <div class="library-item-copy">
              <p class="library-kind"><%= saved_item_kind(saved_item) %></p>
              <h2>
                <%= link_to saved_item_title(saved_item), polymorphic_path(saved_item.item) %>
              </h2>
            </div>
            <%= button_to t("accounts.library.remove"),
                  saved_item_path(saved_item),
                  method: :delete,
                  class: "library-remove",
                  aria: { label: t("accounts.library.remove_label", title: saved_item_title(saved_item)) } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="guide-callout">
        <h2><%= t("accounts.library.empty_heading") %></h2>
        <p><%= t("accounts.library.empty") %></p>
        <%= link_to t("accounts.library.make_one"), root_path, class: "button button-primary" %>
      </div>
    <% end %>

    <%= render "shared/resource_navigation", current_section: :account %>
  </article>
</div>
