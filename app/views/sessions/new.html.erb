<% content_for :title, t("accounts.login.title") %>
<% content_for :description, t("accounts.login.description") %>
<% content_for :robots, "noindex, nofollow" %>

<div class="account-shell">
  <header class="account-heading">
    <p class="eyebrow"><%= t("accounts.eyebrow") %></p>
    <h1><%= t("accounts.login.heading") %></h1>
    <p><%= t("accounts.login.intro") %></p>
  </header>

  <%= render "shared/flash" %>
  <%= render "shared/account_context" %>

  <div class="account-panel">
    <% if google_sign_in_available? %>
      <%= render "shared/google_sign_in" %>
      <p class="account-divider"><%= t("accounts.divider") %></p>
    <% end %>

    <% if @sign_in_failed %>
      <p class="form-errors" id="sign-in-error" role="alert"><%= t("accounts.login.failure") %></p>
    <% end %>

    <%= form_with url: session_path, class: "account-form" do |form| %>
      <div class="field">
        <%= form.label :email_address, t("accounts.email") %>
        <%= form.email_field :email_address, required: true, autocomplete: "username", value: params[:email_address], aria: { invalid: @sign_in_failed ? "true" : nil, describedby: @sign_in_failed ? "sign-in-error" : nil } %>
      </div>
      <div class="field">
        <%= form.label :password, t("accounts.password") %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, aria: { invalid: @sign_in_failed ? "true" : nil, describedby: @sign_in_failed ? "sign-in-error" : nil } %>
      </div>
      <%= form.button t("accounts.login.submit"), class: "button #{google_sign_in_available? ? "button-secondary" : "button-primary"}" %>
    <% end %>
  </div>

  <div class="account-links">
    <p><%= link_to t("accounts.forgot_password"), new_password_path %></p>
    <p><%= link_to t("accounts.register_link"), new_registration_path %></p>
    <%= button_to t("redesign_support.account.cancel"), session_path, method: :delete, params: { cancel: true }, class: "button-text account-cancel" %>
  </div>
</div>
