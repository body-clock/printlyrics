<% content_for :title, t("accounts.register.title") %>
<% content_for :description, t("accounts.register.description") %>
<% content_for :robots, "noindex, nofollow" %>

<div class="guide-shell">
  <article class="guide">
    <header>
      <h1><%= t("accounts.register.heading") %></h1>
      <p><%= t("accounts.register.intro") %></p>
    </header>

    <%# A refused submission is news, not a field note, and a host that turned
        registrations away says so through the flash: both are said here. %>
    <%= render "shared/flash" %>
    <%= render "shared/alert", message: @user.errors.full_messages.to_sentence if @user.errors.any? %>

    <%= form_with model: @user, url: registrations_path, class: "account-form" do |form| %>
      <div class="field">
        <%= form.label :email_address, t("accounts.email") %>
        <%= form.email_field :email_address, required: true, autocomplete: "email" %>
      </div>
      <div class="field">
        <div class="field-label-row">
          <%= form.label :password, t("accounts.password") %>
          <span><%= password_hint %></span>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, t("accounts.password_confirmation") %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <%= form.submit t("accounts.register.submit"), class: "button button-primary" %>
    <% end %>

    <%= render "shared/google_sign_in" if google_sign_in_available? %>

    <div class="account-links">
      <p><%= link_to t("accounts.login_link"), new_session_path %></p>
    </div>
    <%= render "shared/resource_navigation", current_section: :accounts %>
  </article>
</div>
