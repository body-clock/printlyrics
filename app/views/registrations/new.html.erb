<% content_for :title, t("accounts.register.title") %>
<% content_for :description, t("accounts.register.description") %>
<% content_for :robots, "noindex, nofollow" %>

<div class="account-shell">
  <header class="account-heading">
    <p class="eyebrow"><%= t("accounts.eyebrow") %></p>
    <h1><%= t("accounts.register.heading") %></h1>
    <p><%= t(google_sign_in_available? ? "accounts.register.intro_with_google" : "accounts.register.intro",
            limit: SavedItem::LIMIT) %></p>
  </header>

  <%= render "shared/flash" %>
  <%= render "shared/account_context" %>

  <div class="account-panel">
    <% if google_sign_in_available? %>
      <%= render "shared/google_sign_in" %>
      <p class="account-divider"><%= t("accounts.divider") %></p>
    <% end %>

    <%= render "shared/form_errors", errors: @user.errors %>
    <%= form_with model: @user, url: registrations_path, class: "account-form" do |form| %>
      <div class="field">
        <%= form.label :email_address, t("accounts.email") %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", **field_feedback_attributes(@user, :email_address) %>
        <%= render "shared/field_feedback", record: @user, attribute: :email_address %>
      </div>
      <div class="field">
        <%= form.label :password, t("accounts.password") %>
        <p class="field-hint" id="user_password_hint"><%= password_hint %></p>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MINIMUM_LENGTH, maxlength: 72, **field_feedback_attributes(@user, :password, hint: "user_password_hint") %>
        <%= render "shared/field_feedback", record: @user, attribute: :password %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, t("accounts.password_confirmation") %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MINIMUM_LENGTH, maxlength: 72, **field_feedback_attributes(@user, :password_confirmation) %>
        <%= render "shared/field_feedback", record: @user, attribute: :password_confirmation %>
      </div>
      <%= form.button t("accounts.register.submit"), class: "button #{google_sign_in_available? ? "button-secondary" : "button-primary"}" %>
    <% end %>
  </div>

  <div class="account-links">
    <p><%= link_to t("accounts.login_link"), new_session_path %></p>
    <%= button_to t("redesign_support.account.cancel"), session_path, method: :delete, params: { cancel: true }, class: "button-text account-cancel" %>
  </div>
</div>
