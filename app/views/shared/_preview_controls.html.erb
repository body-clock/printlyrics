<%
  # The same control serves a single sheet, the song being read, and the whole
  # set. The caller supplies the current values and, in a songbook,
  # `scope: "active"` or `scope: "all"`.
  size = local_assigns.fetch(:size, "m")
  columns = local_assigns.fetch(:columns, 1)
  scope = local_assigns[:scope]

  size_data = { preview_layout: "size" }
  size_data[:preview_layout_scope] = scope if scope
  column_data = { preview_layout: "columns" }
  column_data[:preview_layout_scope] = scope if scope
%>

<%= tag.fieldset class: "segmented-control", data: size_data do %>
  <legend><%= t(".size") %></legend>
  <% %w[s m l xl].each do |value| %>
    <button type="button"
            class="<%= "is-active" if value == size %>"
            aria-pressed="<%= value == size %>"
            data-action="preview#setSize"
            data-preview-value="<%= value %>"><%= t(".sizes.#{value}") %></button>
  <% end %>
<% end %>

<%= tag.fieldset class: "segmented-control columns-control", data: column_data do %>
  <legend><%= t(".columns") %></legend>
  <% [ 1, 2 ].each do |value| %>
    <button type="button"
            class="<%= "is-active" if value.to_s == columns.to_s %>"
            aria-pressed="<%= value.to_s == columns.to_s %>"
            data-action="preview#setColumns"
            data-preview-value="<%= value %>"><%= value %></button>
  <% end %>
<% end %>
