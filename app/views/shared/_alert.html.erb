<%# One message, said the way every message in this application is said: a mark, a
    role that tells a screen reader whether it is good news, and the tinted panel
    that carries it. `kind` is "alert" for anything the visitor has to act on. %>
<% kind = local_assigns.fetch(:kind, "alert") %>
<% is_error = kind.to_s == "alert" %>
<div class="flash <%= is_error ? "flash-error" : "flash-success" %>"
     role="<%= is_error ? "alert" : "status" %>">
  <span class="flash-mark" aria-hidden="true"><%= is_error ? "!" : "✓" %></span>
  <span><%= message %></span>
</div>
