<%#
  Offered wherever the tab already holds more than one sheet: the sheet just
  generated, and the entry panel a visitor returns to for the next one. Whether
  there is more than one is session storage, so the strip stays hidden until the
  controller confirms it.

  The form breaks out of the entry panel's Turbo frame: creating a set lands on
  the set's own page, which is not a frame render.
%>
<div class="songbook-prompt no-print <%= local_assigns[:class_name] %>"
     data-controller="songbook-prompt"
     hidden>
  <p class="songbook-prompt-message"
     data-songbook-prompt-target="message"
     data-template="<%= t("shared.songbook_prompt.message") %>"
     role="status"></p>

  <%= button_to t("shared.songbook_prompt.action"),
        songbooks_path,
        class: "button button-primary button-songbook",
        data: { action: "songbook-prompt#accept" },
        form: { data: { songbook_prompt_target: "form", turbo_frame: "_top" } } %>

  <button type="button"
          class="songbook-prompt-dismiss"
          data-action="songbook-prompt#dismiss"><%= t("shared.songbook_prompt.dismiss") %></button>
</div>
