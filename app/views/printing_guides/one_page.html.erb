<%
  description = t(".seo.description")
  step_keys = %i[complete columns font_size preview print_settings]
  steps = step_keys.each_with_index.map do |step, index|
    {
      "@type": "HowToStep",
      position: index + 1,
      name: t(".steps.#{step}.heading"),
      text: t(".steps.#{step}.body")
    }
  end
  # Built from the same locale keys the page renders, so the markup cannot drift
  # from the visible steps. Bing still reads structured data, and it is the
  # site's largest traffic source.
  structured_data = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: t(".heading"),
    description: description,
    url: print_lyrics_on_one_page_url,
    step: steps
  }
%>
<% content_for :title, t(".seo.title") %>
<% content_for :description, description %>
<% content_for :canonical_url, print_lyrics_on_one_page_url %>
<% content_for :robots, "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw json_escape(structured_data.to_json) %></script>
<% end %>

<div class="guide-shell">
  <article class="guide">
    <header>
      <p class="eyebrow"><%= t(".eyebrow") %></p>
      <h1><%= t(".heading") %></h1>
      <p><%= t(".introduction") %></p>
    </header>

    <section class="guide-answer" aria-labelledby="short-answer">
      <h2 id="short-answer"><%= t(".answer.heading") %></h2>
      <p><%= t(".answer.body_html", tool_link: link_to(t(".answer.tool_link"), root_path)) %></p>
    </section>

    <ol class="guide-steps">
      <% step_keys.each do |step| %>
        <li>
          <h2><%= t(".steps.#{step}.heading") %></h2>
          <p><%= t(".steps.#{step}.body") %></p>
        </li>
      <% end %>
    </ol>

    <section class="faq guide-faq" aria-labelledby="one-page-questions">
      <p class="eyebrow"><%= t(".faq.eyebrow") %></p>
      <h2 id="one-page-questions"><%= t(".faq.heading") %></h2>

      <% %i[columns font_size overflow].each do |question| %>
        <details>
          <summary><%= t(".faq.questions.#{question}.heading") %></summary>
          <p><%= t(".faq.questions.#{question}.body") %></p>
        </details>
      <% end %>
    </section>

    <section class="guide-callout" aria-labelledby="guide-tool-heading">
      <h2 id="guide-tool-heading"><%= t(".callout.heading") %></h2>
      <p><%= t(".callout.body") %></p>
      <%= link_to t(".callout.link"), root_path, class: "button button-primary" %>
    </section>
  </article>

  <%= render "shared/resource_navigation", current_section: :guide %>
</div>
