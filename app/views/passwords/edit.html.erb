<% content_for :title, t("accounts.password_reset.title") %>
<% content_for :description, t("accounts.password_reset.description") %>
<% content_for :robots, "noindex, nofollow" %>

<div class="guide-shell">
  <article class="guide">
    <header><h1><%= t("accounts.password_reset.edit_heading") %></h1></header>
    <%= render "shared/flash" %>
    <%= form_with url: password_path(params[:token]), method: :put, class: "account-form" do |form| %>
      <div class="field">
        <div class="field-label-row">
          <%= form.label :password, t("accounts.password") %>
          <span><%= password_hint %></span>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, t("accounts.password_confirmation") %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <%= form.submit t("accounts.password_reset.save_submit"), class: "button button-primary" %>
    <% end %>
  </article>
</div>
