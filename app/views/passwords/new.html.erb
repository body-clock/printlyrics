<% content_for :title, t("accounts.password_reset.title") %>
<% content_for :description, t("accounts.password_reset.description") %>
<% content_for :robots, "noindex, nofollow" %>

<div class="guide-shell">
  <article class="guide account-page">
    <%= render "shared/account_bar" %>

    <header>
      <h1><%= t("accounts.password_reset.new_heading") %></h1>
      <p><%= t("accounts.password_reset.new_intro") %></p>
    </header>

    <%= render "shared/flash" %>

    <%= form_with url: passwords_path, class: "account-form" do |form| %>
      <div class="field">
        <%= form.label :email_address, t("accounts.email") %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", value: params[:email_address] %>
      </div>
      <%= form.submit t("accounts.password_reset.email_submit"), class: "button button-secondary" %>
    <% end %>

    <div class="account-links">
      <p><%= link_to t("accounts.login_link_short"), new_session_path %></p>
    </div>
  </article>
</div>
