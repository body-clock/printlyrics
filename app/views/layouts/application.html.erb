<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <% if content_for?(:robots) %>
      <meta name="robots" content="<%= content_for(:robots) %>">
    <% end %>
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:type" content="<%= content_for?(:og_type) ? content_for(:og_type) : "website" %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:site_name" content="<%= t("application.name") %>">
    <meta property="og:locale" content="<%= t("application.og_locale") %>">
    <meta property="og:image" content="<%= root_url %>social-card.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= t("application.meta.image_alt") %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= root_url %>social-card.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("application.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f4f0e8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1d1d1b" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <% if turnstile_site_key %>
      <!-- Cloudflare Turnstile gates the feedback form. The script loads once
           per page; the turnstile controller renders a widget per form. The
           nonce is Cloudflare's recommended way to let the widget load its own
           resources, and the origin is allowlisted in the CSP as well. -->
      <script async defer
              src="https://challenges.cloudflare.com/turnstile/v0/api.js"
              nonce="<%= content_security_policy_nonce %>"></script>
    <% end %>

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-f0moCFg03qwW-u-pSexGt.js"></script>
    <script nonce="<%= content_security_policy_nonce %>">
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init({ autoCapturePageviews: false })
    </script>

    <% if google_analytics_id %>
      <!-- Google Analytics 4, measuring beside Plausible during the dual run.
           docs/organic-search-operations.md owns the cutover. -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ERB::Util.url_encode(google_analytics_id) %>"></script>
      <script nonce="<%= content_security_policy_nonce %>">
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){ window.dataLayer.push(arguments) };
        window.gtag("js", new Date());
        // Pageviews are sent by lib/analytics.js on turbo:load, where the token
        // path is redacted; an automatic pageview would report the real URL.
        // `raw` matters: ERB escapes this literal's quotes, and a script element
        // is raw text, so an entity-escaped quote is a syntax error that kills
        // the whole bootstrap and every event with it. json_escape keeps it safe.
        window.gtag("config", <%= raw json_escape(google_analytics_id.to_json) %>, {
          send_page_view: false,
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });
      </script>
    <% end %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>" type="application/manifest+json">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for?(:body_class) ? content_for(:body_class) : nil %>"
        data-analytics-campaigns="<%= analytics_campaign_data %>"
        <% if content_for?(:generated_page_key) %>data-generated-page-key="<%= yield :generated_page_key %>"<% end %>
        <% if content_for?(:created_songbook_size) %>data-created-songbook-size="<%= yield :created_songbook_size %>"<% end %>
        <% if content_for?(:created_songbook_origin) %>data-created-songbook-origin="<%= yield :created_songbook_origin %>"<% end %>>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
