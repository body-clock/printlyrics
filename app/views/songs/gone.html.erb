<% content_for :title, t(".seo.title", title: @song.title) %>
<% content_for :description, t(".seo.description") %>
<% content_for :canonical_url, song_url(@song) %>
<% content_for :robots, "noindex, follow" %>

<div class="song-shell">
  <%= turbo_frame_tag "lyric_entry" do %>
    <article class="song-card">
      <p class="eyebrow"><%= t(".eyebrow") %></p>
      <h1><%= @song.title %></h1>
      <p><%= t(".body") %></p>
      <%= link_to t(".link"), root_path, class: "button button-primary" %>
    </article>
  <% end %>

  <%= render "shared/resource_navigation", current_section: :songs %>
</div>
